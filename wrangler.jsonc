{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thumbs-studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thumbs-studio",
      "migrations_dir": "migrations",
      "database_id": "bbed656b-8236-4ca4-bb60-b8221a7d2c21",
    },
  ],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "APP_ORIGIN": "https://thumbs-studio.thumbs-manager.workers.dev" },
}
